# Program to implement Selection Sort and Bubble Sort

# Selection Sort
def selection_sort(a):
    n = len(a)

    for i in range(n):
        min_index = i

        for j in range(i + 1, n):
            if a[j] < a[min_index]:
                min_index = j

        a[i], a[min_index] = a[min_index], a[i]

    return a


# Bubble Sort
def bubble_sort(a):
    n = len(a)

    for i in range(n):
        for j in range(0, n - i - 1):
            if a[j] > a[j + 1]:
                a[j], a[j + 1] = a[j + 1], a[j]

    return a


# Main Program
salaries = list(map(float, input("Enter employee salaries: ").split()))

# Selection Sort
a = salaries.copy()
selection_sort(a)
print("Salaries sorted using Selection Sort:", a)

# Bubble Sort
b = salaries.copy()
bubble_sort(b)
print("Salaries sorted using Bubble Sort:", b)

# Display top five highest salaries
print("Top five highest salaries:")

for salary in b[-5:][::-1]:
    print(salary)
             